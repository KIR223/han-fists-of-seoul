{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "han-fists-of-seoul",
  "version": "0.0.1",
  "builtin-baseline": "9a5dfef5d1a0438a7d24856a85bd60f309d355e9",
  "description": "HAN Engine: все сторонние библиотеки проекта объявлены здесь. Версии фиксирует builtin-baseline.",
  "default-features": ["tests", "window", "ui", "assets"],
  "features": {
    "tests": {
      "description": "Только тесты (быстрая сборка и CI)",
      "dependencies": ["doctest"]
    },
    "window": {
      "description": "Окно, ввод и Vulkan (E1, E2): SDL3, заголовки и загрузчик Vulkan",
      "dependencies": ["sdl3", "vulkan-headers", "vulkan-loader"]
    },
    "assets": {
      "description": "Конвейер ассетов (E3): импорт glTF, декодирование картинок, оптимизация мешей",
      "dependencies": ["fastgltf", "meshoptimizer", "stb"]
    },
    "ui": {
      "description": "Отладочный интерфейс (E1, E2): Dear ImGui с привязками SDL3 и Vulkan",
      "dependencies": [{ "name": "imgui", "features": ["sdl3-binding", "vulkan-binding"] }]
    },
    "engine": {
      "description": "Все библиотеки движка (включается по мере появления модулей): -DVCPKG_MANIFEST_FEATURES=tests;engine",
      "dependencies": [
        "sdl3",
        "volk",
        "vulkan-memory-allocator",
        "glm",
        "joltphysics",
        "ozz-animation",
        "entt",
        "miniaudio",
        "fastgltf",
        "meshoptimizer",
        "ktx",
        "rmlui",
        "freetype",
        "harfbuzz",
        { "name": "imgui", "features": ["sdl3-binding", "vulkan-binding"] },
        "lua",
        "sol2",
        "simdjson",
        "nlohmann-json",
        "tomlplusplus",
        "spdlog",
        "tracy",
        "recastnavigation"
      ]
    }
  }
}
