<rml>
<head>
    <title>HAN: демо интерфейса</title>
    <link type="text/rcss" href="ui_demo.rcss"/>
</head>
<body>
    <div id="hud">
        <div class="panel hero">
            <div class="name">ТЫ · 한 (Хан)</div>
            <div class="bar"><div id="health-bar" class="fill health" style="width: 68%;"></div><span class="value" id="health-value">68</span></div>
            <div class="bar small"><div class="fill stamina" style="width: 92%;"></div></div>
            <div class="bar small"><div class="fill balance" style="width: 74%;"></div></div>
            <div class="hint">здоровье · стамина · баланс</div>
        </div>
        <div class="panel foe">
            <div class="name">ВРАГ · 양아치 (Ян-а-чхи)</div>
            <div class="bar"><div class="fill foehealth" style="width: 41%;"></div><span class="value">41</span></div>
        </div>
        <div class="combo">КОМБО: Раз-два-три · 원투쓰리</div>
    </div>
    <div id="menu">
        <div class="title">Пауза · 일시정지</div>
        <div id="btn-resume" class="button">Продолжить · 계속하기</div>
        <div id="btn-settings" class="button">Настройки · 설정</div>
        <div id="btn-quit" class="button danger">Выйти · 나가기</div>
    </div>
    <div class="keys">ЛКМ — удары · ПКМ — блок · Space — уклон · Q — шолдер-ролл · Enter — пауза</div>
</body>
</rml>
